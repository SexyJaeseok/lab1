{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "calc_static 디버깅",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/calc/calc_static",
            "args": ["20", "4"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/calc",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "make calc"
        }
    ]
}
